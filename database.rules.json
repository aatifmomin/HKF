// Hasnain Karimain Foundation - Realtime Database rules.
//
// Paste into Firebase Console > Realtime Database > Rules, then Publish.
// (The console accepts these // comments; a strict JSON parser will not.)
//
// This is the rule set you sent on 2 Sep, unchanged except for INDEXES. You
// had already added /settings, /reminderLog, /techSupport,
// /techSupportCounter, /announcements, /collectors and /collectorTransfers -
// thank you, that was the blocker from the last three rounds and it is gone.
//
// What is added here, and only this:
//
//   /techSupport         .indexOn memberUid, status, createdAtMillis
//   /collectorTransfers  .indexOn collectorUid, transferredAtMillis
//   /announcements       .indexOn postedAtMillis
//
// A missing index is not a permission error, so nothing breaks without them.
// What happens instead is that Firebase downloads the WHOLE node to the phone
// or browser and sorts it there, and logs "Consider adding .indexOn" to the
// console on both clients. The member's own ticket list is the one that
// actually queries the server (orderByChild("memberUid").equalTo(uid)), so
// that index is the one worth having as the ticket table grows.
//
// Everything else below is exactly what you sent. The two apps share these
// paths, and tightening a rule here would break whichever client happens to
// write it a different way. See the note at the bottom for what this rule set
// does and does not enforce.

{
  "rules": {
    "owner_email": {
      ".read": false,
      ".write": false
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == root.child('owner_email').val()"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == root.child('owner_email').val()"
    },
    "members": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["emailLower", "memberId"]
    },
    "membersCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["dateMillis"]
    },
    "paymentRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["memberUid", "status", "createdAtMillis"]
    },
    "paymentProofs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "joinRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "requestedAtMillis"]
    },
    "handovers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["applicationNumber", "status"]
    },
    "handoverDocs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "handoversCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "techSupport": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["memberUid", "status", "createdAtMillis"]
    },
    "techSupportCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reminderLog": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["postedAtMillis"]
    },
    "collectors": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "collectorTransfers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["collectorUid", "transferredAtMillis"]
    }

    // Legacy: /messages, /presence and /notifications are not listed, so they
    // are already denied. The group chat is gone from both clients; once
    // you're happy with this build you can delete those nodes from the
    // database.
  }
}

// WHAT THIS RULE SET DOES AND DOESN'T ENFORCE
//
// /admins and /settings are genuinely locked down: both require the owner
// email, checked server-side against /owner_email. Everywhere else, any
// signed-in Google account can write. In particular a signed-in non-member
// could, in principle, write /members/{their own uid} and skip the join
// queue.
//
// That is not an oversight to fix casually. Realtime Database rules have no
// queries, so "is this email in /admins?" cannot be expressed - /admins is
// keyed by push id and rules cannot scan it. The check that IS cheap is
//
//     root.child('members').child(auth.uid).exists()
//
// i.e. "does this account have an approved member row". Adding that to
// /handovers, /paymentRequests and /paymentProofs would be a real
// improvement and costs nothing, because in both clients only approved
// members ever write those paths.
//
// /members itself is the awkward one: Android's ensureMemberExists writes
// /members/{uid} for an admin who has no member row yet, and the
// pre-registration claim writes /members/{uid} for someone who is not yet a
// member by definition. Tighten that node and those flows break. Leave it as
// it is unless both clients change together.
//
// TWO NEW NODES WORTH KNOWING ABOUT
//
// /collectors/{uid} is written by that admin about themselves, but the rule
// above lets any signed-in account write any collector's profile - including
// their QR. Both clients only ever write their own uid, so this is a
// theoretical hole rather than a live one, and it is the one node here where
// a tighter rule costs nothing at all:
//
//     "collectors": {
//       ".read": "auth != null",
//       "$uid": { ".write": "auth != null && auth.uid == $uid" }
//     }
//
// That is safe to adopt today - neither client writes another admin's
// profile. Do it when you next touch these rules.
//
// /collectorTransfers is the money trail: an admin records what they moved to
// the foundation. It has to stay writable by any admin (they record their
// own) and deletable (a mistyped amount is deleted, not disputed), so it
// cannot be tightened the same way. The owner's view in My Collections is
// what makes it accountable, not the rules.
