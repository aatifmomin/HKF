// Hasnain Karimain Foundation - Realtime Database rules.
//
// Paste into Firebase Console > Realtime Database > Rules, then Publish.
// (The console accepts these // comments; a strict JSON parser will not.)
//
// This is YOUR existing rule set with FOUR nodes added. Both clients now read
// and write /settings, the Reminder tab writes /reminderLog, and Tech Support
// uses /techSupport + /techSupportCounter - none of these were
// listed before, and an unlisted path in Realtime Database is DENIED, not
// allowed. That means:
//
//   * Settings > Save link / Save reminder silently fails on both clients
//   * the Share & refer card can't read apkLink, so it falls back
//   * "Remind all" can't record who sent the round, so the
//     "Reminder given by ..." line never appears
//   * Tech Support is completely dead - members can't file a ticket and the
//     owner's queue stays empty
//
// Everything else below is unchanged from what you sent, deliberately. The
// two apps share these paths, and tightening a rule here would break
// whichever client happens to write it a different way. See the note at the
// bottom for what this rule set does and does not enforce.

{
  "rules": {
    "owner_email": {
      ".read": false,
      ".write": false
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == root.child('owner_email').val()"
    },
    "members": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["emailLower", "memberId"]
    },
    "membersCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["dateMillis"]
    },
    "paymentRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["memberUid", "status", "createdAtMillis"]
    },
    "paymentProofs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Keyed by auth uid. requestedAtMillis is the timestamp both clients
    // write - the index previously named a field that does not exist.
    "joinRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["status", "requestedAtMillis"]
    },

    "handovers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["applicationNumber", "status"]
    },
    "handoverDocs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "handoversCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // NEW - was missing, so every write was being rejected.
    // apkLink / reminderDay / reminderText. Read by everyone (the share card
    // and the member reminder banner need it); the owner-only restriction on
    // writing is enforced in the UI on both clients, like the other nodes.
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // NEW - was missing. Single global node recording who sent this month's
    // reminder round: { monthKey, byName, byEmail, atMillis }.
    "reminderLog": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // NEW - tech-support tickets. Members file them from their Support tab,
    // the owner resolves them from Settings.
    //
    // The index matters: the member screen queries
    // orderByChild("memberUid").equalTo(uid) so a member's device only
    // receives their own tickets. Without ".indexOn" Firebase still returns
    // the right rows, but downloads the entire node to filter client-side -
    // which means every member's browser pulls down everyone's ticket text.
    //
    // Read has to be granted on the parent (a query cannot be authorised
    // per-child), so this is the same "any signed-in account" boundary as
    // every other node here. The narrowing is done by the query, not the rule.
    "techSupport": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["memberUid", "status", "createdAtMillis"]
    },

    "techSupportCounter": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    }

    // Legacy: /messages and /presence are not listed, so they are already
    // denied. The group chat is gone from both clients; once you're happy
    // with this build you can delete those two nodes from the database.
  }
}

// WHAT THIS RULE SET DOES AND DOESN'T ENFORCE
//
// Only /admins is genuinely locked down (owner email, checked server-side
// against /owner_email). Everywhere else, any signed-in Google account can
// write. In particular a signed-in non-member could, in principle, write
// /members/{their own uid} and skip the join queue.
//
// That is not an oversight to fix casually. Realtime Database rules have no
// queries, so "is this email in /admins?" cannot be expressed - /admins is
// keyed by push id and rules cannot scan it. The check that IS cheap is
//
//     root.child('members').child(auth.uid).exists()
//
// i.e. "does this account have an approved member row". Adding that to
// /handovers, /paymentRequests and /paymentProofs would be a real
// improvement and costs nothing, because in both clients only approved
// members ever write those paths.
//
// /members itself is the awkward one: Android's ensureMemberExists writes
// /members/{uid} for an admin who has no member row yet, and the
// pre-registration claim writes /members/{uid} for someone who is not yet a
// member by definition. Tighten that node and those flows break. Leave it as
// it is unless both clients change together.
